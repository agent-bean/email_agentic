{
  "uid": "email-assistant",
  "title": "Email Assistant",
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "title": "API up",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"email-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tool calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (email_tool_calls_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Job time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(email_job_seconds_sum[5m]) / rate(email_job_seconds_count[5m])",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
