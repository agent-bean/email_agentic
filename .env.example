# Local setup configuration. Paths are relative to the repository root.
# This template is not yet consumed by application code.

# Fill before testing LLM/Tavily integrations.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
TAVILY_API_KEY=

# Google: place the downloaded OAuth client file at the path below.
# The token file is created by the OAuth setup flow; do not fill manually.
GOOGLE_OAUTH_CLIENT_FILE=.secrets/google/oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=.secrets/google/token.json
GOOGLE_TEST_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_ID=
DEMO_RECIPIENT_EMAIL=

# VPS connection. Use a dedicated key; do not copy unrelated private keys.
VPS_HOST=
VPS_SSH_PORT=22
VPS_SSH_USER=
VPS_SSH_KEY_FILE=.secrets/ssh/vps-key

# Hostnames without a URL scheme. Tunnel/Access are configured during setup.
APP_HOSTNAME=
GRAFANA_HOSTNAME=
CLOUDFLARED_CREDENTIALS_FILE=.secrets/cloudflare/tunnel.json

# Application settings. Processing timeout will be set during setup.
APP_TIMEZONE=Asia/Bangkok
REPORT_TARGET_SECONDS=42
RESEARCH_TIMEOUT_SECONDS=
POSTGRES_PASSWORD=

# Optional proposed backup target: private Cloudflare R2 via restic.
# Leave empty until the backup proposal is accepted and configured.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=.secrets/backup/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
