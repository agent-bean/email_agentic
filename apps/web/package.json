  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
